.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml   
#Standalone HTML
slidedecks/standaloneHTML/
#OldSlidedecks
slidedecks/oldSlidedecks/
